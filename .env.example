# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Reference — Titan Football Tips
# ─────────────────────────────────────────────────────────────────────────────
#
# This file documents all environment-specific values used by the app.
#
# In this Expo project, env values are defined in  app.json → expo.extra
# and accessed via `expo-constants` (Constants.expoConfig.extra).
# No .env file or dotenv package is needed — Expo handles it natively.
#
# Billing goes directly through Google Play Billing (expo-iap). There is no
# third-party subscription vendor in this app.
#
# ─── app.json → expo.extra.billing ───────────────────────────────────────────
#
#   "billingEnabled": true,
#   "billing": {
#     "productIds": {
#       "special_vvip":   "titan_special_vvip",
#       "correct_scores": "titan_correct_scores",
#       "htft_vip":       "titan_htft_vip",
#       "ovun_sure":      "titan_ovun_sure_tips",
#       "odds_10_plus":   "titan_10_plus_odds",
#       "fixed_draws":    "titan_fixed_special_draws",
#       "special_combo":  "titan_special_combo"
#     },
#     "verificationBaseUrl": "https://api.titanfootballtips.com",
#     "verificationApiKey":  "<SHARED_KEY_SENT_AS_x-api-key>",
#     "termsUrl":            "https://…/terms",
#     "privacyUrl":          "https://…/privacy",
#     "supportEmail":        "support@titanfootballtips.com",
#     "trustClientWhenUnverified": false
#   }
#
# productIds
#   Keys are internal plan IDs from src/config/subscription-config.ts and must
#   not change. Values are the Play Console subscription IDs and must match the
#   console exactly. A plan with no entry here is hidden from the app rather
#   than shown as unpurchasable.
#
# verificationBaseUrl        (REQUIRED for production)
#   Base URL of the service that verifies purchase tokens against the Google
#   Play Developer API. Leave it empty and the app fails closed: purchases are
#   never acknowledged and no entitlement is granted. See
#   docs/play-billing-compliance.md for the three endpoints it must expose.
#
# verificationApiKey
#   Optional shared secret sent as the `x-api-key` header. This is a low-value
#   credential — it ships inside the APK, so it rate-limits abuse rather than
#   authenticating anyone. The Play Developer API service account must live on
#   the server and never in this file.
#
# trustClientWhenUnverified  (DEBUG ONLY)
#   Grants entitlements straight from the store payload so licence testers can
#   exercise the purchase flow before the verification service exists. Ignored
#   entirely in release builds (guarded on __DEV__). Never rely on it.
#
# ─── Other extra values ──────────────────────────────────────────────────────
#
# communityUrl   Telegram community link shown on the home screen.
#
# ─── Files involved ──────────────────────────────────────────────────────────
#
# app.json                              → source of truth for all values
# src/config/env.ts                     → reads and normalises them
# src/config/subscription-config.ts     → joins plan definitions to product IDs
# src/services/billing/                 → Play Billing + verification adapters
